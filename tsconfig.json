{
  "compilerOptions": {
    "paths": {
      "@muzieklijsten/*": ["./src/frontend/shared/*"]
    },
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "es2022"],
    "module": "esnext",
    "target": "es2022",
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "strict": true,
    "allowUnreachableCode": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["./src/frontend/**/*", "./*.ts", "./eslint.config.js"]
}
