<?xml version="1.0"?>
<ruleset
    name="muzieklijsten"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpcodesniffer.com/phpcs.xsd"
>
    <config name="php_version" value="80134" />
    <arg name="extensions" value="php" />
    <file>./</file>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <!-- Legacy includes die een keer weg moeten -->
    <exclude-pattern>*/src/php/OLERead\.php$</exclude-pattern>
    <exclude-pattern>*/src/php/PhpExcelReader\.php$</exclude-pattern>
    <exclude-pattern>*/src/php/SSP\.php$</exclude-pattern>

    <rule ref="OmroepGelderland" />

    <!-- Uitzonderingen uit de generieke standaard toch gebruiken -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps" />
    <rule ref="Squiz.Classes.ValidClassName" />

    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>*/src/php/exceptions\.php$</exclude-pattern>
        <exclude-pattern>*/src/php/ajax/exceptions\.php$</exclude-pattern>
        <exclude-pattern>*/src/php/youtube/exceptions\.php$</exclude-pattern>
    </rule>
    <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes.DeclareStrictTypesMissing">
        <type>warning</type>
    </rule>
    <rule ref="Generic.Files.InlineHTML.Found">
        <type>warning</type>
    </rule>
</ruleset>
