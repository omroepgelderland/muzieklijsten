{
  "name": "omroep_gelderland/muzieklijsten",
  "description": "Stemmodule voor muziek",
  "type": "project",
  "authors": [
    {
      "name": "Sander Otten",
      "email": "sotten@gld.nl"
    },
    {
      "name": "Remy Glaser",
      "email": "rglaser@gld.nl"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.1",
    "google/recaptcha": "^1.2",
    "ext-mysqli": "*",
    "ext-intl": "*",
    "omroepgelderland/phpstdlib": "^3.0",
    "php-di/php-di": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "muzieklijsten\\": "src/php/"
    },
    "classmap": [
      "src/php/exceptions.php"
    ],
    "files": [
      "src/php/controllers.php",
      "src/php/functies.php"
    ]
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "squizlabs/php_codesniffer": "^4.0",
    "slevomat/coding-standard": "^8.15",
    "zorac/phpstan-php-di": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
